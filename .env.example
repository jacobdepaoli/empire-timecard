# Copy to .env for local development. On Vercel these are Project → Settings → Environment Variables.
# Supabase: Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Google Maps JavaScript API key (live crew map).
# Restrict it by HTTP referrer to your deployed domain in the Google Cloud console.
VITE_GOOGLE_MAPS_KEY=
